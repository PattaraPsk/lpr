{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SelenLPR_IO_Contract",
  "description": "Standardized API Contract for Thai License Plate Detection, Classification & OCR",
  "input": {
    "image_source": "string (file_path | base64 | stream_url)"
  },
  "output": {
    "detections": [
      {
        "bbox": [ "x1", "y1", "x2", "y2" ],
        "normalized_coords": {
          "s_x": 0.352,
          "s_y": 0.612,
          "s_w": 0.185,
          "s_h": 0.082
        },
        "confidence": 0.95,
        "plate_design": {
          "background_color": "white | yellow | orange | green",
          "text_color": "black | green | blue | white",
          "layout": "standard_single_row | motorcycle_double_row"
        },
        "vehicle_type": {
          "category_id": "private_car | private_pickup | private_van | public_taxi | tuktuk | trailer_tractor | service_vehicle | motorcycle",
          "description": "Private Pickups (2-door light commercial trucks)"
        },
        "reading": {
          "d3": "บป",
          "d4": "4512",
          "province": "ชลบุรี",
          "full_plate": "บป 4512 ชลบุรี"
        }
      }
    ]
  }
}
